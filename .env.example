# Salin berkas ini menjadi ".env" (tanpa .example) lalu isi nilainya.
# Berkas .env tidak boleh di-commit ke GitHub.
GREENRIDE_DB=Host=<host-pooler-supabase>;Port=5432;Database=postgres;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
# Opsional: leaderboard lewat REST API Supabase (jalankan docs/leaderboard_api.sql dulu).
# Bila kosong, leaderboard memakai koneksi database langsung.
GREENRIDE_API_URL=https://<project-ref>.supabase.co
GREENRIDE_API_KEY=<anon-key>
