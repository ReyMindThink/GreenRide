<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <!-- Judul halaman (HALO, JOHN DOE! / RINGKASAN / LEADERBOARD) -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <!-- Judul kartu / judul layar auth -->
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <!-- Ikon garis -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource InkBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>

  <!-- Responsif: Window diberi pseudo-class :compact / :medium oleh MainWindow -->
  <Style Selector="Window:compact TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
  </Style>

</Styles>
