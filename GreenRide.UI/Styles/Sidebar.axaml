<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Sidebar putih 232 px (desain). Di jendela sempit (:compact) hanya ikon, 72 px. -->
  <Style Selector="Border.sidebar">
    <Setter Property="Width" Value="232" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="Window:compact Border.sidebar">
    <Setter Property="Width" Value="72" />
  </Style>
  <Style Selector="Window:compact TextBlock.navText">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Baris menu -->
  <Style Selector="Button.nav">
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Window:compact Button.nav">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandBgBrush}" />
  </Style>
  <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandBgBrush}" />
  </Style>

  <Style Selector="TextBlock.navText">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Garis pemisah tipis di atas/bawah tombol Keluar -->
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
  </Style>

  <!-- Area halaman di sebelah sidebar -->
  <Style Selector="ContentControl.page">
    <Setter Property="Margin" Value="24,40,40,40" />
  </Style>
  <Style Selector="Window:compact ContentControl.page">
    <Setter Property="Margin" Value="14,20,14,20" />
  </Style>

</Styles>
