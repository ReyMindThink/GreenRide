<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GreenRide.UI.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="GreenRide.UI.Views.CatatView"
             x:DataType="vm:CatatViewModel">

  <!-- Ukuran di bawah ini nilai "lebar". CatatView.axaml.cs menggantinya saat tampilan menyempit. -->
  <UserControl.Resources>
    <x:Double x:Key="GreetingSize">32</x:Double>
    <x:Double x:Key="CardTitleSize">22</x:Double>
    <x:Double x:Key="BadgeBoxHeight">250</x:Double>
    <x:Double x:Key="ShelfIconHeight">126</x:Double>
    <x:Double x:Key="TimerSize">40</x:Double>
    <x:Double x:Key="ModeCardHeight">242</x:Double>
    <x:Double x:Key="ModeIconWidth">120</x:Double>
    <x:Double x:Key="ModeIconHeight">100</x:Double>
    <x:Double x:Key="ModeLabelSize">22</x:Double>
    <Thickness x:Key="CardPadding">24</Thickness>
    <Thickness x:Key="TripCardPadding">8,24,8,8</Thickness>
    <Thickness x:Key="ModeInnerMargin">8,0,8,28</Thickness>
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16">

      <TextBlock Classes="h1" FontSize="{DynamicResource GreetingSize}" Text="{Binding Greeting}"
                 TextWrapping="Wrap" />

      <Grid x:Name="Root" ColumnDefinitions="528*,448*" RowDefinitions="Auto,Auto,Auto">

        <!-- Badge minggu lalu -->
        <Border x:Name="BadgeCard" Grid.Row="0" Grid.Column="0" Classes="card"
                MinHeight="409" Padding="{DynamicResource CardPadding}" Margin="0,4,4,4">
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <Border Height="{DynamicResource BadgeBoxHeight}">
              <svg:Svg Path="{Binding LastBadgeIcon}" />
            </Border>
            <TextBlock Text="{Binding LastBadgeName}" FontSize="{DynamicResource CardTitleSize}"
                       FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,24,0,0" />
            <TextBlock Text="{Binding LastBadgeDescription}" FontSize="14" TextAlignment="Center"
                       TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <!-- Koleksi Badge -->
        <Border x:Name="ShelfCard" Grid.Row="1" Grid.Column="0" Classes="card"
                MinHeight="266" Padding="{DynamicResource CardPadding}" Margin="0,4,4,0">
          <StackPanel Spacing="16">
            <TextBlock Text="Koleksi Badge" FontSize="{DynamicResource CardTitleSize}" FontWeight="Bold" />
            <ItemsControl x:Name="ShelfList" ItemsSource="{Binding Shelf}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BadgeShelfItem">
                  <StackPanel Margin="4,0,4,12" Spacing="4">
                    <Border Height="{DynamicResource ShelfIconHeight}">
                      <svg:Svg Path="{Binding IconUri}" />
                    </Border>
                    <TextBlock Text="{Binding Nama}" FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock Classes="caption" Text="{Binding BatasLabel}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Catat perjalanan hari ini -->
        <Border x:Name="TripCard" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Classes="card"
                MinHeight="683" Padding="{DynamicResource TripCardPadding}" Margin="4,0,0,4">
          <StackPanel>
            <TextBlock Text="Catat Perjalanan Hari Ini" FontSize="{DynamicResource CardTitleSize}"
                       FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding TimerText}" FontSize="{DynamicResource TimerSize}"
                       FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock Text="{Binding CaptionText}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="16,8,16,0" />
            <TextBlock Classes="error" Text="{Binding ErrorMessage}" TextAlignment="Center"
                       TextWrapping="Wrap" HorizontalAlignment="Center" Margin="16,8,16,0"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <ItemsControl ItemsSource="{Binding Modes}" Margin="0,16,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ModeCardItem">
                  <Button Classes="moda" Classes.active="{Binding IsActive}"
                          Height="{DynamicResource ModeCardHeight}"
                          IsEnabled="{Binding IsEnabled}" Command="{Binding Command}"
                          Margin="6">
                    <Grid RowDefinitions="*,Auto,Auto" Margin="{DynamicResource ModeInnerMargin}">
                      <svg:Svg Grid.Row="0" Path="{Binding IconUri}"
                               Width="{DynamicResource ModeIconWidth}"
                               Height="{DynamicResource ModeIconHeight}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Text="{Binding Label}"
                                 FontSize="{DynamicResource ModeLabelSize}" FontWeight="Bold"
                                 HorizontalAlignment="Center" Margin="0,12,0,0" />
                      <TextBlock Grid.Row="2" Text="{Binding FaktorLabel}" FontSize="13"
                                 HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </Grid>

    </StackPanel>
  </ScrollViewer>

</UserControl>