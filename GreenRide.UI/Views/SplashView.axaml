<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GreenRide.UI.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="GreenRide.UI.Views.SplashView"
             x:DataType="vm:SplashViewModel">

  <UserControl.Styles>
    <Style Selector="Border.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.1" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.35" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Border Classes="pulse" HorizontalAlignment="Center" VerticalAlignment="Center">
    <svg:Svg Path="/Assets/Images/logo.svg" Width="96" Height="96" />
  </Border>

</UserControl>
