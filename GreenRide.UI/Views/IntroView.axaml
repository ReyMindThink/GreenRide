<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GreenRide.UI.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="GreenRide.UI.Views.IntroView"
             x:DataType="vm:IntroViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border MaxWidth="440" Margin="24,32" VerticalAlignment="Center">
      <StackPanel Spacing="20">

        <svg:Svg Path="/Assets/Images/logo.svg" Width="60" Height="60" HorizontalAlignment="Center" />

        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Selamat Datang di GreenRide" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="Catat perjalananmu, kurangi emisi, dan kumpulkan badge!"
                     TextAlignment="Center" TextWrapping="Wrap" FontSize="13"
                     Foreground="{DynamicResource InkSoftBrush}" />
        </StackPanel>

        <!-- Tiga poin fitur -->
        <StackPanel Spacing="16">

          <Grid ColumnDefinitions="Auto,*">
            <Path Classes="icon" Data="{DynamicResource Icon.Catat}" Width="34" Height="34" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
              <TextBlock Classes="label" Text="Catat Perjalananmu" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}"
                         Text="Pilih moda dan durasi, emisi akan dihitung otomatis" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="Auto,*">
            <Path Classes="icon" Data="{DynamicResource Icon.History}" Width="34" Height="34" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
              <TextBlock Classes="label" Text="Pantau Emisi Mingguan" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}"
                         Text="Grafik dan kalender harian membantu kamu memantau emisi dari hasil mobilitasmu" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="Auto,*">
            <Path Classes="icon" Data="{DynamicResource Icon.Trophy}" Width="34" Height="34" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
              <TextBlock Classes="label" Text="Raih Badge" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}"
                         Text="Dapatkan badge dari tingkat Eco Initiate, Carbon Tamer, Terra Sentinel, hingga Zero Trace" />
            </StackPanel>
          </Grid>

        </StackPanel>

        <Button Classes="primary" Content="Masuk" Command="{Binding GoToLoginCommand}"
                HorizontalAlignment="Stretch" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
          <TextBlock Classes="muted" Text="Belum punya akun?" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextGrayBrush}" />
          <Button Classes="link" Content="Daftar" Command="{Binding GoToRegisterCommand}" />
        </StackPanel>

      </StackPanel>
    </Border>
  </ScrollViewer>

</UserControl>
