<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GreenRide.UI.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="GreenRide.UI.Views.ShellView"
             x:DataType="vm:ShellViewModel">

  <Grid ColumnDefinitions="Auto,*">

    <!-- Sidebar -->
    <Border Classes="sidebar">
      <Grid RowDefinitions="Auto,*,Auto" Margin="16,24,16,32">

        <svg:Svg Grid.Row="0" Path="/Assets/Images/logo.svg" Width="48" Height="48" HorizontalAlignment="Left" />

        <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}" Margin="0,24,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Button Classes="nav" Classes.active="{Binding IsActive}" Command="{Binding Command}"
                      ToolTip.Tip="{Binding Title}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Path Classes="icon" Data="{Binding Icon}" Width="20" Height="20" />
                  <TextBlock Classes="navText" Text="{Binding Title}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2" Spacing="8">
          <Border Classes="divider" />
          <Button Classes="nav" Command="{Binding SignOutCommand}" ToolTip.Tip="Keluar">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="{Binding KeluarIcon}" Width="20" Height="20" />
              <TextBlock Classes="navText" Text="KELUAR" />
            </StackPanel>
          </Button>
          <Border Classes="divider" />
        </StackPanel>

      </Grid>
    </Border>

    <!-- Halaman aktif -->
    <ContentControl Grid.Column="1" Classes="page" Content="{Binding CurrentPage}" />

  </Grid>

</UserControl>
