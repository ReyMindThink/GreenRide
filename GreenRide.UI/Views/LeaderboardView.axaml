<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GreenRide.UI.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="GreenRide.UI.Views.LeaderboardView"
             x:DataType="vm:LeaderboardViewModel">

  <UserControl.Resources>
    <x:Double x:Key="TitleSize">32</x:Double>
    <Thickness x:Key="CardPadding">20</Thickness>
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16">

      <TextBlock Classes="h1" Text="LEADERBOARD" FontSize="{DynamicResource TitleSize}" TextWrapping="Wrap" />

      <TextBlock Classes="error" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- Podium: peringkat 2, 1, 3 -->
      <Border Classes="card" Padding="{DynamicResource CardPadding}">
        <ItemsControl x:Name="PodiumList" ItemsSource="{Binding Podium}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PodiumItem">
              <Border Classes="soft" Classes.first="{Binding IsFirst}" Margin="6" Padding="16"
                      MinHeight="200" CornerRadius="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                  <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Center"
                          Background="{DynamicResource BrandBgBrush}">
                    <TextBlock Text="{Binding RankText}" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Border Height="72" IsVisible="{Binding HasIcon}">
                    <svg:Svg Path="{Binding IconUri}" />
                  </Border>
                  <TextBlock Text="{Binding NamaText}" FontSize="16" FontWeight="Bold"
                             TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding EmisiText}" FontSize="18" FontWeight="ExtraBold"
                             Foreground="{DynamicResource ForestBrush}" HorizontalAlignment="Center" />
                  <TextBlock Classes="caption" Text="{Binding BadgeName}" HorizontalAlignment="Center"
                             TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- Peringkat berikutnya -->
      <Border Classes="card" Padding="{DynamicResource CardPadding}">
        <StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Peringkat minggu ini" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" />
          </StackPanel>

          <Grid x:Name="RankHeader" ColumnDefinitions="64,3*,2*,2*" Margin="12,14,12,8">
            <TextBlock Classes="muted" Text="Peringkat" />
            <TextBlock Grid.Column="1" Classes="muted" Text="Nama" />
            <TextBlock Grid.Column="2" Classes="muted" Text="Badge" />
            <TextBlock Grid.Column="3" Classes="muted" Text="Emisi CO₂" />
          </Grid>

          <ItemsControl x:Name="RankListWide" ItemsSource="{Binding Rows}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LeaderRowItem">
                <Border Classes="soft" Classes.me="{Binding IsMe}" Padding="12,0" Height="40" Margin="0,0,0,2">
                  <Grid ColumnDefinitions="64,3*,2*,2*" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RankText}" FontSize="14" FontWeight="Bold" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Nama}" FontSize="14" FontWeight="SemiBold" />
                      <Border Background="White" CornerRadius="4" Padding="8,2" IsVisible="{Binding IsMe}">
                        <TextBlock Text="Kamu" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource ForestBrush}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding BadgeName}" FontSize="13" />
                    <TextBlock Grid.Column="3" Text="{Binding EmisiText}" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource ForestBrush}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl x:Name="RankListNarrow" ItemsSource="{Binding Rows}" Margin="0,12,0,0" IsVisible="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LeaderRowItem">
                <Border Classes="soft" Padding="12,10" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="36,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.RowSpan="2" Text="{Binding RankText}" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Nama}" FontSize="14" FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailText}" FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextGrayBrush}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="muted" Text="Peringkat dihitung dari total emisi minggu berjalan. Semakin rendah, semakin baik."
                     Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>