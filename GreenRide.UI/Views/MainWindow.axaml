<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GreenRide.UI.ViewModels"
        x:Class="GreenRide.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="GreenRide"
        Width="1280" Height="832"
        MinWidth="360" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrandBgBrush}"
        Foreground="{DynamicResource InkBrush}">

  <ContentControl Content="{Binding Navigation.Current}" />

</Window>
