<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GreenRide.UI.Controls.PasswordBox">

  <!-- Input password dengan tombol mata (tampilkan / sembunyikan). -->
  <Grid>
    <TextBox x:Name="Input" Classes="gr" Height="46" CornerRadius="10"
             PasswordChar="•" Padding="14,0,52,0" />

    <ToggleButton x:Name="Eye" Classes="eye"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,6,0" Width="36" Height="36" Focusable="False"
                  ToolTip.Tip="Tampilkan / sembunyikan password">
      <Panel>
        <Path x:Name="IconHidden" Classes="icon" Data="{DynamicResource Icon.EyeOff}" Width="18" Height="18" />
        <Path x:Name="IconShown" Classes="icon" Data="{DynamicResource Icon.Eye}" Width="18" Height="18" IsVisible="False" />
      </Panel>
    </ToggleButton>
  </Grid>

</UserControl>
