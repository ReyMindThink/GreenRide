<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GreenRide.UI.ViewModels"
             xmlns:views="using:GreenRide.UI.Views"
             x:Class="GreenRide.UI.App"
             RequestedThemeVariant="Light">

  <!-- Pemetaan ViewModel ke View. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:SplashViewModel">
      <views:SplashView />
    </DataTemplate>
    <DataTemplate DataType="vm:IntroViewModel">
      <views:IntroView />
    </DataTemplate>
    <DataTemplate DataType="vm:LoginViewModel">
      <views:LoginView />
    </DataTemplate>
    <DataTemplate DataType="vm:RegisterViewModel">
      <views:RegisterView />
    </DataTemplate>
    <DataTemplate DataType="vm:ShellViewModel">
      <views:ShellView />
    </DataTemplate>
    <DataTemplate DataType="vm:CatatViewModel">
      <views:CatatView />
    </DataTemplate>
    <DataTemplate DataType="vm:RingkasanViewModel">
      <views:RingkasanView />
    </DataTemplate>
    <DataTemplate DataType="vm:RevisiViewModel">
      <views:RevisiView />
    </DataTemplate>
    <DataTemplate DataType="vm:LeaderboardViewModel">
      <views:LeaderboardView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GreenRide.UI/Styles/Colors.axaml" />
        <ResourceInclude Source="avares://GreenRide.UI/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://GreenRide.UI/Styles/Typography.axaml" />
    <StyleInclude Source="avares://GreenRide.UI/Styles/Buttons.axaml" />
    <StyleInclude Source="avares://GreenRide.UI/Styles/Inputs.axaml" />
    <StyleInclude Source="avares://GreenRide.UI/Styles/Cards.axaml" />
    <StyleInclude Source="avares://GreenRide.UI/Styles/Sidebar.axaml" />
    <StyleInclude Source="avares://GreenRide.UI/Styles/Summary.axaml" />
  </Application.Styles>
</Application>
